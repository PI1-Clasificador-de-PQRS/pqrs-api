# Copia este archivo a .env para desarrollo local. Nunca subas .env al repositorio.

# Conexión a PostgreSQL (driver psycopg 3).
DATABASE_URL=postgresql+psycopg://pqrs:pqrs@localhost:5432/pqrs

# Nombre de la cookie de sesión.
SESSION_COOKIE_NAME=pqrs_session

# La cookie lleva el atributo Secure. Déjalo en true salvo en desarrollo local por HTTP.
SESSION_COOKIE_SECURE=false

# Horas de inactividad tras las cuales caduca la sesión.
SESSION_IDLE_HOURS=8

# Intentos fallidos de login permitidos (por email y por IP) dentro de la ventana.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Nivel de logging: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Proxies de confianza que agregan una entrada a X-Forwarded-For entre el cliente y la API.
# La IP del cliente (para el límite de intentos de login) es la entrada N contando desde la
# DERECHA de la cabecera; lo que haya a su izquierda lo controla quien llama y se ignora.
#   0  (por defecto) ignora la cabecera y usa la IP de la conexión. Usa 0 en local y siempre que
#      la API reciba tráfico sin un proxy de confianza delante.
#   N  cuenta los proxies que agregan una entrada. Un valor mayor que el real deja que quien llama
#      falsifique su IP; uno menor da la IP de un proxy y agrupa a todos los usuarios en un cubo.
# Azure Container Apps: la ingress agrega una entrada y el proxy del dashboard debe agregar la IP
# real del navegador, así que para el tráfico del dashboard hacia la API por su ingress el valor
# esperado es 2 (1 si solo hay ingress). Compruébalo en el despliegue antes de fiarte de él.
TRUSTED_PROXY_HOPS=0

# Base de datos usada por pytest (se crea sola si no existe).
TEST_DATABASE_URL=postgresql+psycopg://pqrs:pqrs@localhost:5432/pqrs_test
