# Copia este archivo a .env para desarrollo local. Nunca subas .env al repositorio.

# Conexión a PostgreSQL (driver psycopg 3).
DATABASE_URL=postgresql+psycopg://pqrs:pqrs@localhost:5432/pqrs

# Nombre de la cookie de sesión.
SESSION_COOKIE_NAME=pqrs_session

# La cookie lleva el atributo Secure. Déjalo en true salvo en desarrollo local por HTTP.
SESSION_COOKIE_SECURE=false

# Horas de inactividad tras las cuales caduca la sesión.
SESSION_IDLE_HOURS=8

# Intentos fallidos de login permitidos (por email y por IP) dentro de la ventana.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Nivel de logging: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Leer la IP del cliente desde X-Forwarded-For. Actívalo solo detrás del proxy del dashboard,
# que debe enviar la cabecera; de lo contrario el límite por IP vería siempre la IP del proxy.
TRUST_FORWARDED_FOR=false

# Base de datos usada por pytest (se crea sola si no existe).
TEST_DATABASE_URL=postgresql+psycopg://pqrs:pqrs@localhost:5432/pqrs_test
