# Copia este archivo a .env para desarrollo local. Nunca subas .env al repositorio.

# Conexión a PostgreSQL (driver psycopg 3).
DATABASE_URL=postgresql+psycopg://pqrs:pqrs@localhost:5432/pqrs

# Nombre de la cookie de sesión.
SESSION_COOKIE_NAME=pqrs_session

# La cookie lleva el atributo Secure. Déjalo en true salvo en desarrollo local por HTTP.
SESSION_COOKIE_SECURE=false

# Horas de inactividad tras las cuales caduca la sesión.
SESSION_IDLE_HOURS=8

# Vida máxima de una sesión desde el login (horas), aunque tenga actividad reciente: pasado este
# tiempo hay que iniciar sesión de nuevo (401 session_expired).
SESSION_MAX_HOURS=24

# Límite de intentos fallidos de login, en la misma ventana de LOGIN_WINDOW_MINUTES:
#   LOGIN_MAX_ATTEMPTS         por par (email, IP); frena la fuerza bruta sobre una cuenta sin que
#                              alguien desde otra IP pueda bloquear al usuario legítimo.
#   LOGIN_MAX_ATTEMPTS_PER_IP  por IP sola, con cualquier email; frena a quien prueba muchas cuentas.
#   LOGIN_MAX_ATTEMPTS_PER_EMAIL  por email solo, desde cualquier IP (respaldo).
# Al superarlo, 429 too_many_attempts. El límite es en memoria: sirve para una sola réplica.
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
# Respaldo frente a un ataque repartido entre muchas IP contra un mismo correo (50 fallos bloquean
# los logins de ese correo hasta que venza la ventana).
LOGIN_MAX_ATTEMPTS_PER_EMAIL=50
LOGIN_WINDOW_MINUTES=15

# Tope de claves del limitador en memoria (mínimo 3; cada fallo usa tres). Al superarlo se desalojan
# primero las de actividad más antigua.
LOGIN_LIMITER_MAX_KEYS=10000

# Nivel de logging: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Secreto compartido con el proxy del dashboard (cabecera X-PQRS-Proxy-Secret). OBLIGATORIO salvo con
# ENVIRONMENT=development: sin él la API no arranca. Con ENVIRONMENT=development y sin secreto, el
# chequeo del proxy se desactiva (cómodo en local); con secreto definido se exige siempre.
# Genera uno con: openssl rand -hex 32
# PROXY_SHARED_SECRET=

# Tamaño máximo del cuerpo de una petición, en bytes (413 payload_too_large al superarlo).
MAX_BODY_BYTES=1048576

# Solicitudes por minuto a /models, /classify y /classify/batch, por API key y por usuario (nunca
# por IP). Al superarlo, 429 rate_limited con Retry-After. En memoria: una sola réplica.
RATE_LIMIT_KEY_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=120

# Proxies de confianza que agregan una entrada a X-Forwarded-For entre el cliente y la API.
# La IP del cliente (para el límite de intentos de login) es la entrada N contando desde la
# DERECHA de la cabecera; lo que haya a su izquierda lo controla quien llama y se ignora.
#   0  (por defecto) ignora la cabecera y usa la IP de la conexión. Usa 0 en local y siempre que
#      la API reciba tráfico sin un proxy de confianza delante.
#   N  cuenta los proxies que agregan una entrada. Un valor mayor que el real deja que quien llama
#      falsifique su IP; uno menor da la IP de un proxy y agrupa a todos los usuarios en un cubo.
# El tráfico del dashboard ya no depende de esto: el proxy manda la IP del navegador en
# X-PQRS-Client-IP junto con el secreto. TRUSTED_PROXY_HOPS cubre el resto del tráfico (sistemas
# externos y peticiones sin secreto válido).
# Azure Container Apps: la ingress agrega una entrada, así que el valor recomendado es 1.
# Compruébalo en el despliegue antes de fiarte de él.
TRUSTED_PROXY_HOPS=0

# `development` relaja las exigencias de producción (secreto del proxy, modelo NER de spaCy).
ENVIRONMENT=development

# Motor local: directorio con model.joblib y metadata.json (release v0.1.0 de pqrs-classifier).
# Si no carga, la API arranca igual: /ready responde 503 y /models muestra `not_loaded`.
MODEL_DIR=/opt/model
# Clasificaciones simultáneas del motor local (acota la memoria).
CLASSIFIER_MAX_CONCURRENCY=2

# Motor LLM (cliente compatible con OpenAI). Sin clave y modelo queda `not_configured`.
# El LLM ve solo los primeros MAX_CARACTERES_TEXTO caracteres de cada texto (1200 por defecto,
# el protocolo con el que se evaluó); el motor local recibe el texto completo.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=8
# LLM_WORKERS=2
# MAX_CARACTERES_TEXTO=1200
# F1 macro del LLM que muestran /models y /metrics/summary (validación cruzada del paquete).
LLM_EVAL_F1_MACRO=0.8329

# Circuito de protección del LLM (en memoria, una sola réplica): se abre tras N fallos
# consecutivos o con un 429 del proveedor, y permanece abierto al menos N segundos.
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_OPEN_SECONDS=60

# Base de datos usada por pytest (se crea sola si no existe).
TEST_DATABASE_URL=postgresql+psycopg://pqrs:pqrs@localhost:5432/pqrs_test
